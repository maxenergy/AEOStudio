# AEOStudio 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 注意：不要将真实值提交到版本控制

# =============================================================================
# 运行时模式
# =============================================================================

# Node 环境: development | test | production
NODE_ENV=development

# Fake 模式开关（仅 development/test 环境有效）
# 生产环境 (NODE_ENV=production) 下这些设置会被忽略并 fail closed
AEOSTUDIO_ALLOW_FAKE_RUNTIME=true
AEOSTUDIO_AUTH_MODE=fake
AEOSTUDIO_CHANNEL_ADAPTER_MODE=fake
AEOSTUDIO_GIT_PROVIDER_MODE=fake
AEOSTUDIO_WORDPRESS_PROVIDER_MODE=fake
AEOSTUDIO_SHOPIFY_PROVIDER_MODE=fake
AEOSTUDIO_WEBHOOK_PROVIDER_MODE=fake
AEOSTUDIO_MEASUREMENT_PROVIDER_MODE=fake

# =============================================================================
# API 服务器
# =============================================================================

# API 监听端口
PORT=3200

# API 监听地址
HOST=127.0.0.1

# Web 前端来源（用于 CORS 和 redirect）
WEB_ORIGIN=http://127.0.0.1:3100

# =============================================================================
# 数据库 (PostgreSQL)
# =============================================================================

# 数据库连接 URL
# 格式: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://aeostudio:aeostudio@127.0.0.1:5432/aeostudio

# API 数据库连接池大小
API_DATABASE_POOL_MAX=10

# =============================================================================
# 会话加密
# =============================================================================

# Session 加密密钥 (base64url 编码, 32 字节)
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEY=

# =============================================================================
# OIDC / Cognito 身份认证
# =============================================================================

# OIDC Issuer URL (Cognito User Pool)
# 格式: https://cognito-idp.{region}.amazonaws.com/{poolId}
OIDC_ISSUER=

# OIDC Client ID
OIDC_CLIENT_ID=aeostudio-web

# OIDC Client Secret (可选, 用于 confidential client)
OIDC_CLIENT_SECRET=

# OIDC Redirect URI
OIDC_REDIRECT_URI=http://127.0.0.1:3100/api/auth/callback

# =============================================================================
# AWS 配置
# =============================================================================

# AWS 区域 (固定为 ap-southeast-1)
AWS_REGION=ap-southeast-1

# AWS 账号 ID
AWS_ACCOUNT_ID=

# =============================================================================
# S3 存储
# =============================================================================

# Evidence/Artifact 存储桶名称
S3_EVIDENCE_BUCKET=

# S3 KMS 密钥 ARN
S3_KMS_KEY_ARN=

# =============================================================================
# SQS 队列
# =============================================================================

# Job 队列 URL
SQS_JOB_QUEUE_URL=

# Job 死信队列 URL
SQS_JOB_DLQ_URL=

# =============================================================================
# Secrets Manager
# =============================================================================

# Connector Secret 前缀
SECRETS_CONNECTOR_PREFIX=aeostudio/connector/

# =============================================================================
# 删除回执签名
# =============================================================================

# 删除回执令牌签名密钥 (base64url 编码)
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DELETION_RECEIPT_SIGNING_KEY=

# =============================================================================
# Worker 配置
# =============================================================================

# Worker 模式: sqs | fake
AEOSTUDIO_WORKER_MODE=fake

# =============================================================================
# 可观测性
# =============================================================================

# OpenTelemetry Collector 端点
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# 日志级别: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
