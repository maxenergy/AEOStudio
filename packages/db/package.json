{
  "name": "@aeostudio/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "development": "./src/auth/index.ts",
      "default": "./dist/auth/index.js"
    },
    "./channels-publishing": {
      "types": "./src/channels-publishing/index.ts",
      "development": "./src/channels-publishing/index.ts",
      "default": "./dist/channels-publishing/index.js"
    },
    "./experiments": {
      "types": "./src/experiments/index.ts",
      "development": "./src/experiments/index.ts",
      "default": "./dist/experiments/index.js"
    },
    "./measurement": {
      "types": "./src/measurement/index.ts",
      "development": "./src/measurement/index.ts",
      "default": "./dist/measurement/index.js"
    },
    "./privacy-audit": {
      "types": "./src/privacy-audit/index.ts",
      "development": "./src/privacy-audit/index.ts",
      "default": "./dist/privacy-audit/index.js"
    },
    "./tenant-data-broker": {
      "types": "./src/tenant-data-broker/index.ts",
      "development": "./src/tenant-data-broker/index.ts",
      "default": "./dist/tenant-data-broker/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:migrate": "node dist/migrate-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aeostudio/application": "workspace:*",
    "@aeostudio/contracts": "workspace:*",
    "@aeostudio/domain": "workspace:*",
    "@aws-sdk/client-secrets-manager": "3.1090.0",
    "kysely": "0.29.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3"
  }
}
