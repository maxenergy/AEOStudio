{
  "name": "@aeostudio/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./generation": {
      "types": "./src/generation/index.ts",
      "development": "./src/generation/index.ts",
      "default": "./dist/generation/index.js"
    },
    "./crawler": {
      "types": "./src/crawler/index.ts",
      "development": "./src/crawler/index.ts",
      "default": "./dist/crawler/index.js"
    },
    "./identity": {
      "types": "./src/identity/index.ts",
      "development": "./src/identity/index.ts",
      "default": "./dist/identity/index.js"
    },
    "./queue": {
      "types": "./src/queue/index.ts",
      "development": "./src/queue/index.ts",
      "default": "./dist/queue/index.js"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "development": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    },
    "./publication": {
      "types": "./src/publication/index.ts",
      "development": "./src/publication/index.ts",
      "default": "./dist/publication/index.js"
    },
    "./secrets": {
      "types": "./src/secrets/index.ts",
      "development": "./src/secrets/index.ts",
      "default": "./dist/secrets/index.js"
    },
    "./backup": {
      "types": "./src/backup/index.ts",
      "development": "./src/backup/index.ts",
      "default": "./dist/backup/index.js"
    },
    "./tenant-data-broker": {
      "types": "./src/tenant-data-broker/index.ts",
      "development": "./src/tenant-data-broker/index.ts",
      "default": "./dist/tenant-data-broker/index.js"
    },
    "./observability": {
      "types": "./src/observability/index.ts",
      "development": "./src/observability/index.ts",
      "default": "./dist/observability/index.js"
    },
    "./observability/redacting-span-exporter": {
      "types": "./src/observability/redacting-span-exporter.ts",
      "development": "./src/observability/redacting-span-exporter.ts",
      "default": "./dist/observability/redacting-span-exporter.js"
    },
    "./observability/telemetry": {
      "types": "./src/observability/telemetry-runtime.ts",
