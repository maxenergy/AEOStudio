{
  "name": "aeostudio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run --exclude tests/integration/** --exclude tests/ops/**",
    "test:integration": "vitest run tests/integration --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:ops": "vitest run tests/ops",
    "security:verify": "node scripts/security/verify.mjs",
    "smoke:runtime": "node scripts/smoke/runtime-smoke.mjs && node scripts/smoke/web-runtime-origin-smoke.mjs",
    "smoke:staging": "node scripts/smoke/staging-smoke.mjs",
    "restore:staging": "node scripts/recovery/run-restore-drill.mjs",
    "alarms:staging": "node scripts/observability/run-synthetic-alarm-drill.mjs",
    "contracts:generate": "pnpm --filter @aeostudio/contracts build && node scripts/contracts/generate-contracts.mjs",
    "contracts:check": "pnpm --filter @aeostudio/contracts build && node scripts/contracts/generate-contracts.mjs --check",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm contracts:check",
    "verify": "pnpm verify:fast && pnpm test:integration && pnpm test:ops && pnpm build && pnpm smoke:runtime"
  },
  "devDependencies": {
    "@aeostudio/adapters": "workspace:*",
    "@aeostudio/application": "workspace:*",
    "@aeostudio/contracts": "workspace:*",
    "@aeostudio/db": "workspace:*",
    "@aeostudio/domain": "workspace:*",
    "@aeostudio/worker": "workspace:*",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "eslint": "10.7.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.22.0",
    "prettier": "3.9.5",
    "testcontainers": "12.0.4",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
